{
  "name": "skeleton-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "clean:test": "pkill -f 'node.*vitest' || true",
    "clean:e2e": "pkill -f 'playwright test' || true",
    "pretest": "npm run clean:test",
    "test": "vitest run",
    "posttest": "npm run clean:test",
    "pretest:watch": "npm run clean:test",
    "test:watch": "vitest",
    "posttest:watch": "npm run clean:test",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "npm run clean:test",
    "pretest:e2e": "npm run clean:e2e",
    "test:e2e": "playwright test",
    "posttest:e2e": "npm run clean:e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint . && npm run check",
    "push": "gh-pages -t -d build",
    "deploy": "npm run build && npm run push"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@iconify/svelte": "^5.2.2",
    "@playwright/test": "^1.64.1",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
